---
layout: base.njk
title: Visitas a hospitalizados
description: "Horario de visitas, recomendaciones e información a familiares de pacientes hospitalizados en el Hospital de Frutillar."
permalink: visitas.html
---
{% import "componentes.njk" as ui with context %}
{% set d = visitas %}
{% set infoNav = nav | buscar("id", "info") %}
{{ ui.banner(d.titulo, "Horario, recomendaciones e información clínica", "groups", [{ label: "Información al Usuario", url: "/horarios.html" }, { label: "Visitas" }]) }}

{% call ui.dosColumnas() %}
  <div class="min-w-0 flex flex-col gap-6">
    {{ ui.aviso(d.intro | comoCampo("visitas:intro")) }}

    {% call ui.seccion("Horario de visita", "schedule") %}
      <ul class="flex flex-col gap-3">
        {% for h in d.horario %}
        <li class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
          {% campo "visitas:horario." + loop.index0 + ".dias", h.dias, "span", "text-sm text-gray-600" %}
          {% campo "visitas:horario." + loop.index0 + ".horario", h.horario, "strong", "font-cartel text-3xl text-primary-deep leading-none" %}
        </li>
        {% endfor %}
      </ul>
      {# Los datos opcionales siempre van en el HTML (ocultos si están vacíos) para poder completarlos desde la intranet #}
      {% set nota = d.notaHorario | cv("visitas:notaHorario") %}
      <p data-c-ocultar-vacio{% if not nota %} hidden{% endif %} class="text-xs text-gray-500 mt-3">{% campo "visitas:notaHorario", d.notaHorario %}</p>
      {% set maxV = d.maximoVisitas | cv("visitas:maximoVisitas") %}
      {% set infM = d.informeMedico | cv("visitas:informeMedico") %}
      <dl data-c-grupo-vacio{% if not (maxV or infM) %} hidden{% endif %} class="grid sm:grid-cols-2 gap-4 mt-5 pt-5 border-t border-gray-100 text-sm">
        <div data-c-ocultar-vacio{% if not maxV %} hidden{% endif %}><dt class="text-xs font-bold text-gray-500 uppercase tracking-wide">Visitas por paciente</dt>{% campo "visitas:maximoVisitas", d.maximoVisitas, "dd", "text-gray-800 mt-1" %}</div>
        <div data-c-ocultar-vacio{% if not infM %} hidden{% endif %}><dt class="text-xs font-bold text-gray-500 uppercase tracking-wide">Información médica a familiares</dt>{% campo "visitas:informeMedico", d.informeMedico, "dd", "text-gray-800 mt-1" %}</div>
      </dl>
    {% endcall %}

    {% call ui.seccion("Recomendaciones para su visita", "check_circle") %}
      <ul class="flex flex-col gap-3 text-sm text-gray-700">
        {% for r in d.recomendaciones %}
        {% set rr = "visitas:recomendaciones." + loop.index0 %}
        <li data-c-ocultar-vacio{% if not (r | cv(rr)) %} hidden{% endif %} class="flex gap-3"><span aria-hidden="true" class="material-symbols-outlined text-primary text-lg flex-shrink-0">check</span>{% campo rr, r, "span", "leading-relaxed" %}</li>
        {% endfor %}
      </ul>
    {% endcall %}

    <div class="grid md:grid-cols-2 gap-6">
      {% call ui.seccion("Información clínica", "medical_information") %}
        {% campoMd "visitas:informacionClinica", d.informacionClinica, "prose max-w-none text-sm text-gray-700 leading-relaxed" %}
      {% endcall %}
      {% call ui.seccion("Compañía y acompañamiento", "favorite") %}
        {% campoMd "visitas:acompanamiento", d.acompanamiento, "prose max-w-none text-sm text-gray-700 leading-relaxed" %}
      {% endcall %}
    </div>
  </div>

  <aside class="flex flex-col gap-5">
    {{ ui.menuLateral("Información al Usuario", infoNav.items) }}
    {{ ui.saludResponde() }}
  </aside>
{% endcall %}
