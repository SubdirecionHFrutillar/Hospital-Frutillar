---
layout: base.njk
title: Contacto y Cómo Llegar
description: "Información de contacto, dirección, mapa y formulario del Hospital de Frutillar."
permalink: contacto.html
scripts: ["/assets/js/formularios.mjs"]
---
{% import "componentes.njk" as ui with context %}

{{ ui.banner("Contacto y Cómo Llegar", "Formulario de consultas, actualización de datos, dirección y cómo llegar", "place", [{ label: "Contacto" }]) }}

{% call ui.dosColumnas() %}
  <div class="min-w-0 flex flex-col gap-6">

    {% call ui.seccion("Formulario de consultas", "mail", oscuro=true, padding="") %}
      {# Netlify Forms: los envíos quedan en Netlify → Forms → contacto y se notifican por correo (ver README). #}
      <form id="contact-form" name="contacto" method="POST" action="/contacto.html?enviado=1" data-netlify="true" netlify-honeypot="bot-field" data-formulario class="px-6 py-5 flex flex-col gap-4" novalidate>
        <input type="hidden" name="form-name" value="contacto">
        <input type="hidden" name="subject" value="Consulta desde el sitio web — Hospital de Frutillar">
        <p class="hidden"><label>No completar: <input name="bot-field" tabindex="-1" autocomplete="off"></label></p>
        <p class="text-xs text-gray-500">{{ contacto.intro }}</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="nombre" class="block text-xs font-bold text-gray-600 mb-1">Nombre completo <span class="text-red-500" aria-hidden="true">*</span></label>
            <input type="text" id="nombre" name="nombre" required autocomplete="name" placeholder="Ej: María González" class="w-full border-gray-300 rounded-custom px-3 py-2 text-sm focus:border-primary focus:ring-primary-pale">
          </div>
          <div>
            <label for="email" class="block text-xs font-bold text-gray-600 mb-1">Correo electrónico <span class="text-red-500" aria-hidden="true">*</span></label>
            <input type="email" id="email" name="email" required autocomplete="email" placeholder="correo@ejemplo.com" class="w-full border-gray-300 rounded-custom px-3 py-2 text-sm focus:border-primary focus:ring-primary-pale">
          </div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="rut" class="block text-xs font-bold text-gray-600 mb-1">RUT <span class="font-normal text-gray-400">(recomendado para reclamos)</span></label>
            <input type="text" id="rut" name="rut" data-rut maxlength="12" placeholder="12.345.678-9" class="w-full border-gray-300 rounded-custom px-3 py-2 text-sm focus:border-primary focus:ring-primary-pale">
          </div>
          <div>
            <label for="telefono" class="block text-xs font-bold text-gray-600 mb-1">Teléfono</label>
            <input type="tel" id="telefono" name="telefono" autocomplete="tel" inputmode="tel" placeholder="+56 9 1234 5678" class="w-full border-gray-300 rounded-custom px-3 py-2 text-sm focus:border-primary focus:ring-primary-pale">
          </div>
        </div>
        <div>
          <label for="asunto" class="block text-xs font-bold text-gray-600 mb-1">Asunto <span class="text-red-500" aria-hidden="true">*</span></label>
          <select id="asunto" name="asunto" required class="w-full border-gray-300 rounded-custom px-3 py-2 text-sm focus:border-primary focus:ring-primary-pale bg-white">
            <option value="">Seleccione una categoría</option>
            <option value="Consulta general">Consulta general</option>
            <option value="Solicitud de hora">Solicitud de hora</option>
            <option value="Reclamo o sugerencia">Reclamo o sugerencia</option>
            <option value="Solicitud de información">Solicitud de información</option>
            <option value="Felicitación">Felicitación</option>
            <option value="Otro">Otro</option>
          </select>
        </div>
        <div>
          <label for="mensaje" class="block text-xs font-bold text-gray-600 mb-1">Mensaje <span class="text-red-500" aria-hidden="true">*</span></label>
          <textarea id="mensaje" name="mensaje" required rows="5" placeholder="Escriba aquí su consulta o comentario..." class="w-full border-gray-300 rounded-custom px-3 py-2 text-sm focus:border-primary focus:ring-primary-pale resize-none"></textarea>
        </div>
        <div class="flex items-start gap-2">
          <input type="checkbox" id="privacidad" name="privacidad" value="acepta" required class="mt-0.5 flex-shrink-0 rounded text-primary">
          <label for="privacidad" class="text-xs text-gray-500">Acepto el tratamiento de mis datos personales para responder esta consulta.</label>
        </div>
        <div>
          <button type="submit" class="bg-primary hover:bg-primary-dark disabled:opacity-60 text-white font-bold text-sm px-6 py-2.5 rounded-custom transition-colors shadow">Enviar consulta</button>
        </div>
        <div id="form-success" data-ok role="status" tabindex="-1" class="hidden flex items-start gap-2 text-sm text-green-700 bg-green-50 border border-green-200 rounded-custom px-4 py-3">
          <span aria-hidden="true" class="material-symbols-outlined text-green-600 mt-0.5 text-base">check_circle</span>
          <span>Su consulta fue enviada correctamente. Nos comunicaremos con usted a la brevedad.</span>
        </div>
        <div id="form-error" data-error role="alert" class="hidden flex items-start gap-2 text-sm text-red-700 bg-red-50 border border-red-200 rounded-custom px-4 py-3">
          <span aria-hidden="true" class="material-symbols-outlined text-red-600 mt-0.5 text-base">error</span>
          <span data-error-texto>No pudimos enviar su consulta. Intente nuevamente o llame a {{ site.telefonoLabel }} {{ site.telefono }}.</span>
        </div>
      </form>
    {% endcall %}

    {# Actualiza tus datos: mismo formulario que /actualiza-tus-datos.html, desplegable #}
    <details id="actualiza-tus-datos" class="desplegable-datos group bg-white border border-gray-200 rounded-custom shadow-sm overflow-hidden scroll-mt-24">
      <summary class="list-none cursor-pointer px-5 py-4 flex items-center gap-4 border-l-4 border-l-amber-500 hover:bg-amber-50/60">
        <span class="w-11 h-11 bg-amber-500 rounded-full flex items-center justify-center flex-shrink-0"><span aria-hidden="true" class="material-symbols-outlined text-white text-xl">person_edit</span></span>
        <span class="flex-1 min-w-0">
          <span class="block text-primary-deep font-bold text-base tracking-wide uppercase">Actualiza tus datos</span>
          <span class="block text-sm text-gray-500">¿Cambió de dirección, teléfono o previsión? Actualice su registro en el hospital.</span>
        </span>
        <span class="hidden sm:inline-flex items-center gap-1 text-sm font-bold text-amber-700 group-open:hidden">Completar formulario</span>
        <span aria-hidden="true" class="material-symbols-outlined text-amber-700 text-2xl transition-transform group-open:rotate-180">expand_more</span>
      </summary>
      <div class="px-6 py-6 border-t border-gray-100">
        {% include "form-actualiza-datos.njk" %}
      </div>
    </details>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {% set tarjetas = [
        { icono: "location_on", titulo: "Dirección", html: site.direccion + "<br>" + site.region + ", Chile" },
        { icono: "call", titulo: "Teléfonos", html: '<a href="' + site.telefonoHref + '" class="text-primary font-bold hover:underline">' + site.telefono + '</a> <span class="text-xs text-gray-400">' + site.telefonoLabel + ' (24 hrs)</span><br>Central: <a href="' + site.telefonoCentralHref + '" class="text-primary font-bold hover:underline">' + site.telefonoCentral + '</a>' },
        { icono: "schedule", titulo: "Urgencias", html: "Abierto <strong>24 horas</strong><br>todos los días del año" },
        { icono: "directions_bus", titulo: "Cómo llegar", html: "Buses desde Puerto Montt, Puerto Varas y Osorno. Parada frente al hospital en Av. Philippi." }
      ] %}
      {% for t in tarjetas %}
      <div class="info-card bg-white border border-gray-200 rounded-custom shadow-sm p-5 flex items-start gap-4">
        <div class="w-11 h-11 bg-primary-bg rounded-full flex items-center justify-center flex-shrink-0">
          <span aria-hidden="true" class="material-symbols-outlined text-primary text-xl">{{ t.icono }}</span>
        </div>
        <div>
          <h2 class="font-bold text-gray-800 text-sm mb-1">{{ t.titulo }}</h2>
          <p class="text-sm text-gray-600">{{ t.html | safe }}</p>
        </div>
      </div>
      {% endfor %}
    </div>

    <div class="bg-primary-bg border border-primary-pale rounded-custom p-5 flex items-start gap-3">
      <span aria-hidden="true" class="material-symbols-outlined text-primary mt-0.5 flex-shrink-0">support_agent</span>
      <div>
        <p class="text-sm font-bold text-primary mb-1">OIRS — Oficina de Informaciones, Reclamos y Sugerencias</p>
        <p class="text-sm text-gray-700">{{ contacto.oirs_descripcion }}</p>
        {% if contacto.oirs_horario %}<p class="text-xs text-gray-500 mt-2"><strong>Horario:</strong> {{ contacto.oirs_horario }}</p>{% endif %}
      </div>
    </div>

    {% call ui.seccion("Ubicación en el mapa", "map", oscuro=true, padding="") %}
      <iframe title="Mapa {{ site.name }}" src="{{ site.mapsEmbed }}" class="block w-full h-80 border-0" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
      <div class="px-4 py-3 bg-gray-50 border-t border-gray-100 flex items-center justify-between flex-wrap gap-2">
        <span class="text-xs text-gray-500">{{ site.direccion }} — {{ site.region }}</span>
        <a href="{{ site.mapsUrl }}" target="_blank" rel="noopener" class="text-xs font-bold text-primary hover:underline flex items-center gap-1">
          <span aria-hidden="true" class="material-symbols-outlined text-sm">open_in_new</span>Abrir en Google Maps
        </a>
      </div>
    {% endcall %}

  </div>

  <aside class="flex flex-col gap-5">
    <div class="bg-white border border-gray-200 rounded-custom shadow-sm overflow-hidden">
      <div class="bg-primary-dark text-white text-xs font-bold uppercase tracking-widest px-4 py-2.5">Directorio</div>
      <ul class="flex flex-col divide-y divide-gray-100">
        {% for d in [
          { i: "emergency", c: "text-red-500", t: "Urgencias", s: "24 horas · acceso directo" },
          { i: "call", c: "text-primary", t: site.telefonoLabel, s: site.telefono, href: site.telefonoHref },
          { i: "campaign", c: "text-primary", t: "OIRS", s: "Oficina de Información, Reclamos y Sugerencias" },
          { i: "account_balance", c: "text-primary", t: "Admisión y SOME", s: "Solicitud de horas y trámites" }
        ] %}
        <li class="acceso-item flex items-start gap-3 px-4 py-3">
          <span aria-hidden="true" class="material-symbols-outlined {{ d.c }} text-lg mt-0.5">{{ d.i }}</span>
          <div>
            <strong class="text-sm text-primary block">{{ d.t }}</strong>
            {% if d.href %}<a href="{{ d.href }}" class="text-xs text-primary font-bold hover:underline">{{ d.s }}</a>{% else %}<span class="text-xs text-gray-500">{{ d.s }}</span>{% endif %}
          </div>
        </li>
        {% endfor %}
      </ul>
    </div>
    <div class="flex flex-col gap-2.5">
      {{ ui.botonTarjeta("/horarios.html", "Horarios de Atención") }}
      {{ ui.botonTarjeta("/faq.html", "Preguntas Frecuentes") }}
      {{ ui.botonTarjeta("/transparencia.html#solicitud", "Solicitud de Información") }}
    </div>
  </aside>
{% endcall %}
