---
layout: base.njk
title: Preguntas Frecuentes
description: "Respuestas a las preguntas más frecuentes sobre atención, trámites, FONASA y servicios del Hospital de Frutillar."
permalink: faq.html
---
{% import "componentes.njk" as ui with context %}

{{ ui.banner("Preguntas Frecuentes", "Respuestas a las dudas más comunes sobre la atención en el Hospital de Frutillar", "help", [{ label: "Información al Usuario", url: "/horarios.html" }, { label: "Preguntas Frecuentes" }]) }}

{% call ui.dosColumnas() %}
  <div class="min-w-0 flex flex-col gap-7">
    {% for cat in faq.categorias %}
    <section id="categoria-{{ loop.index }}" class="scroll-mt-24">
      <h2 class="text-xl font-bold text-primary border-l-4 border-primary-light pl-3 mb-4">{{ cat.titulo }}</h2>
      <div class="flex flex-col gap-2">
        {% for p in cat.preguntas %}
        <details class="bg-white border border-gray-200 rounded-custom shadow-sm overflow-hidden">
          <summary class="flex items-center justify-between px-5 py-4 hover:bg-gray-50 transition-colors">
            <span class="font-semibold text-sm text-gray-800">{{ p.pregunta }}</span>
            <span aria-hidden="true" class="material-symbols-outlined text-primary-light text-xl expand-icon flex-shrink-0 ml-4">expand_more</span>
          </summary>
          <div class="px-5 pb-5 pt-3 text-sm text-gray-600 leading-relaxed border-t border-gray-100">
            <div class="prose max-w-none">{{ p.respuesta | markdown | safe }}</div>
          </div>
        </details>
        {% endfor %}
      </div>
    </section>
    {% endfor %}

    {{ ui.aviso('¿No encontró la respuesta que buscaba? <a href="/contacto.html" class="font-bold hover:underline">Contáctenos</a> o llame a <strong>' + site.telefonoLabel + ': ' + site.telefono + '</strong> para orientación gratuita las 24 horas.') }}
  </div>

  <aside class="flex flex-col gap-5">
    {% set menuFaq = [] %}
    {% for cat in faq.categorias %}{% set menuFaq = (menuFaq.push({ label: cat.titulo, url: "#categoria-" + loop.index }), menuFaq) %}{% endfor %}
    {{ ui.menuLateral("Categorías", menuFaq, "help_outline") }}
    <div class="flex flex-col gap-2.5">
      {{ ui.botonTarjeta("/horarios.html", "Horarios de Atención") }}
      {{ ui.botonTarjeta("/aranceles.html", "Aranceles") }}
      {{ ui.botonTarjeta("/contacto.html", "Contacto y Mapa") }}
      {{ ui.saludResponde() }}
    </div>
  </aside>
{% endcall %}
