---
layout: base.njk
title: Trabaja con Nosotros
description: "Oportunidades de empleo y procesos de selección en el Hospital de Frutillar."
permalink: trabaja-con-nosotros.html
---
{% import "componentes.njk" as ui with context %}

{{ ui.banner("Trabaja con Nosotros", "Oportunidades laborales en el Hospital de Frutillar", "work", [{ label: "Trabaja con Nosotros" }]) }}

{% call ui.dosColumnas() %}
  <div class="min-w-0 flex flex-col gap-6">
    {{ ui.aviso(trabaja.intro) }}

    {% call ui.seccion("Cómo Postular", "assignment") %}
      <div class="prose max-w-none text-sm text-gray-700 leading-relaxed">{{ trabaja.como_postular | markdown | safe }}</div>
    {% endcall %}

    {% call ui.seccion("Información General", "work") %}
      <div class="prose max-w-none text-sm text-gray-700 leading-relaxed">{{ trabaja.body | markdown | safe }}</div>
    {% endcall %}

    <div class="bg-primary-bg border border-primary-pale rounded-custom p-5 flex items-start gap-3">
      <span aria-hidden="true" class="material-symbols-outlined text-primary mt-0.5 flex-shrink-0">contact_mail</span>
      <div>
        <p class="text-sm font-bold text-primary mb-1">Unidad de Recursos Humanos</p>
        <p class="text-sm text-gray-700">{{ trabaja.contacto_rrhh }}</p>
      </div>
    </div>
  </div>

  <aside class="flex flex-col gap-5">
    {{ ui.menuLateral("Sobre el Hospital", [
      { label: "Quiénes Somos", url: "/quienes-somos.html", icon: "groups" },
      { label: "Servicios", url: "/servicios.html", icon: "medical_services" },
      { label: "Transparencia", url: "/transparencia.html", icon: "account_balance" },
      { label: "Contacto y Cómo Llegar", url: "/contacto.html", icon: "place" }
    ]) }}
    {{ ui.enlacesExternos("Concursos Externos", [
      { label: "Empleos Públicos (Servicio Civil)", url: "https://www.empleospublicos.cl" },
      { label: "Servicio de Salud Reloncaví", url: site.ssreloncavi }
    ]) }}
    {{ ui.saludResponde() }}
  </aside>
{% endcall %}
