title: Portal Funcionarios
permalink: funcionarios/index.html
---
{% import "componentes.njk" as ui with context %}
{{ ui.banner("Portal Funcionarios", "Herramientas y accesos para el equipo del Hospital de Frutillar", "badge", [{ label: "Portal Funcionarios" }]) }}

<div class="container mx-auto px-4 py-8" data-pagina="portal">
  <div class="flex flex-wrap items-center justify-between gap-4 bg-white border border-gray-200 rounded-custom shadow-sm px-6 py-5 mb-6">
    <div class="flex items-center gap-4">
      <div class="w-12 h-12 rounded-full bg-primary flex items-center justify-center text-white">
        <span aria-hidden="true" class="material-symbols-outlined">person</span>
      </div>
      <div>
        <p class="text-xs text-gray-400 uppercase tracking-widest font-bold">Bienvenido/a</p>
        <p class="text-lg font-bold text-gray-800" data-campo="nombre">…</p>
        <p class="text-xs text-gray-500"><span data-campo="rut"></span><span data-campo="cargo" class="before:content-['_·_']"></span></p>
      </div>
    </div>
    <button type="button" data-salir class="inline-flex items-center gap-2 text-sm font-bold text-primary border border-primary-pale bg-primary-bg hover:bg-primary-pale px-4 py-2 rounded-custom">
      <span aria-hidden="true" class="material-symbols-outlined text-base">logout</span>Cerrar sesión
    </button>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    {% for t in portal.accesos %}
    <a href="{{ t.url }}"{% if t.url.startsWith("http") %} target="_blank" rel="noopener"{% endif %}{% if t.soloAdmin %} data-solo-admin{% endif %} class="{{ "hidden " if t.soloAdmin }}gob-stripe group bg-white border border-gray-200 rounded-custom shadow-sm hover:shadow-md p-5 flex items-start gap-4 transition-all">
      <div class="w-11 h-11 bg-primary-bg rounded-full flex items-center justify-center flex-shrink-0 group-hover:bg-primary transition-colors">
        <span aria-hidden="true" class="material-symbols-outlined text-primary group-hover:text-white transition-colors">{{ t.icono }}</span>
      </div>
      <div>
        <h2 class="font-bold text-gray-900 text-sm mb-1">{{ t.titulo }}{% if t.url.startsWith("http") %} <span aria-hidden="true" class="material-symbols-outlined text-sm text-gray-400 align-middle">open_in_new</span>{% endif %}</h2>
        <p class="text-xs text-gray-500 leading-relaxed">{{ t.descripcion }}</p>
      </div>
    </a>
    {% endfor %}
  </div>
</div>
