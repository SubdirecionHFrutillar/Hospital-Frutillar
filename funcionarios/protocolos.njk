---
title: Protocolos clínicos
permalink: funcionarios/protocolos.html
---
{% set p = protocolos %}
<section class="text-white" style="background:linear-gradient(135deg,#1A237E 0%,#283593 55%,#3F51B5 100%);">
  <div class="container mx-auto px-4 py-7 flex flex-wrap items-center gap-5">
    <span class="w-14 h-14 rounded-full bg-white/15 flex items-center justify-center flex-shrink-0" aria-hidden="true"><span class="material-symbols-outlined text-3xl">clinical_notes</span></span>
    <div class="flex-1 min-w-[240px]">
      <p class="text-[11px] font-bold uppercase tracking-widest text-indigo-100">Subdirección Médica</p>
      <h1 class="font-cartel font-bold text-3xl md:text-4xl leading-none mt-1">{{ p.titulo }}</h1>
      <p class="text-sm text-indigo-50 mt-2 max-w-3xl">{{ p.descripcion }}</p>
    </div>
  </div>
</section>

<div class="container mx-auto px-4 py-8 flex flex-col gap-6" data-pagina="protocolos">
  <div class="flex flex-wrap items-center gap-3">
    <label for="buscar-protocolo" class="sr-only">Buscar protocolo</label>
    <div class="relative flex-1 min-w-[240px] max-w-xl">
      <span aria-hidden="true" class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-gray-400">search</span>
      <input id="buscar-protocolo" type="search" placeholder="Buscar protocolo (por ejemplo: transfusión, clave azul, UHD)…" autocomplete="off" class="w-full border-gray-300 rounded-custom pl-10 pr-3 py-2.5 text-sm focus:border-indigo-500 focus:ring-indigo-100">
    </div>
    <p id="protocolos-cuenta" class="text-sm text-gray-500" aria-live="polite"></p>
  </div>

  <div id="areas-protocolos" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
    {% for a in p.areas %}
    <article class="protocolo-area" data-area>
      <header class="flex items-start gap-3">
        <span class="protocolo-area__icono" aria-hidden="true"><span class="material-symbols-outlined">{{ a.icono }}</span></span>
        <div class="flex-1 min-w-0">
          <h2 class="font-bold text-primary-deep leading-tight">{{ a.nombre }}</h2>
          <p class="text-xs text-gray-500 leading-snug mt-1">{{ a.descripcion }}</p>
        </div>
      </header>
      <ul class="mt-3 flex flex-col divide-y divide-gray-100 border-t border-gray-100">
        {% for d in a.documentos %}
        <li data-protocolo="{{ (a.nombre + ' ' + d.titulo + ' ' + d.codigo) | lower }}">
          <a href="{{ d.url }}" target="_blank" rel="noopener" class="flex items-center gap-2 py-2 text-[13px] text-gray-800 hover:text-indigo-700">
            <span aria-hidden="true" class="material-symbols-outlined text-base text-indigo-600">{{ "folder" if "/folders/" in d.url else "description" }}</span>
            <span class="flex-1">{{ d.titulo }}</span>{% if d.codigo %}<span class="text-[11px] text-gray-400">{{ d.codigo }}</span>{% endif %}
          </a>
        </li>
        {% endfor %}
      </ul>
      {% if a.url %}
      <a href="{{ a.url }}" target="_blank" rel="noopener" class="mt-auto pt-3 inline-flex items-center gap-1.5 text-xs font-bold text-indigo-700 hover:underline">Ver carpeta completa <span aria-hidden="true" class="material-symbols-outlined text-sm">open_in_new</span></a>
      {% endif %}
    </article>
    {% endfor %}
  </div>
  <p id="sin-protocolos" class="hidden text-sm text-gray-500 bg-white border border-gray-200 rounded-custom px-4 py-6 text-center">No encontramos protocolos con ese nombre. Revise también la <a href="/funcionarios/calidad.html" class="text-indigo-700 font-bold hover:underline">sección Calidad</a>.</p>

  <p class="text-xs text-gray-500">¿Falta un protocolo o hay una versión más nueva? Avise a la Subdirección Médica o a la Unidad de Calidad para actualizar esta página.</p>
</div>
