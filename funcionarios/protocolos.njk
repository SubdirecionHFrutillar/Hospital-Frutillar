---
title: Protocolos clínicos
permalink: funcionarios/protocolos.html
---
{% set p = protocolos %}
<section class="text-white" style="background:linear-gradient(135deg,#1A237E 0%,#283593 55%,#3F51B5 100%);">
  <div class="container mx-auto px-4 py-7 flex flex-wrap items-center gap-5">
    <span class="w-14 h-14 rounded-full bg-white/15 flex items-center justify-center flex-shrink-0" aria-hidden="true"><span class="material-symbols-outlined text-3xl">clinical_notes</span></span>
    <div class="flex-1 min-w-[240px]">
      <p class="text-[11px] font-bold uppercase tracking-widest text-indigo-100">Subdirección Médica</p>
      <h1 class="font-cartel font-bold text-3xl md:text-4xl leading-none mt-1">{{ p.titulo }}</h1>
      <p class="text-sm text-indigo-50 mt-2 max-w-3xl">{{ p.descripcion }}</p>
    </div>
  </div>
</section>

<div class="container mx-auto px-4 py-8 flex flex-col gap-6" data-pagina="protocolos">
  <div class="flex flex-wrap items-center gap-3">
    <label for="buscar-protocolo" class="sr-only">Buscar protocolo</label>
    <div class="relative flex-1 min-w-[240px] max-w-xl">
      <span aria-hidden="true" class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-gray-400">search</span>
      <input id="buscar-protocolo" type="search" placeholder="Buscar protocolo (por ejemplo: transfusión, clave azul, UHD)…" autocomplete="off" class="w-full border-gray-300 rounded-custom pl-10 pr-3 py-2.5 text-sm focus:border-indigo-500 focus:ring-indigo-100">
    </div>
    <p id="protocolos-cuenta" class="text-sm text-gray-500" aria-live="polite"></p>
    <button type="button" id="nuevo-protocolo" data-solo-editor class="hidden ml-auto inline-flex items-center gap-1.5 bg-indigo-700 hover:bg-indigo-800 text-white font-bold text-sm px-4 py-2.5 rounded-custom shadow">
      <span aria-hidden="true" class="material-symbols-outlined text-lg">upload_file</span>Subir protocolo
    </button>
  </div>
  <p id="protocolos-msg" role="status" class="hidden text-sm rounded-custom px-4 py-3"></p>

  <div id="areas-protocolos" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4" aria-busy="true">
    <p class="text-sm text-gray-500">Cargando protocolos…</p>
  </div>
  <p id="sin-protocolos" class="hidden text-sm text-gray-500 bg-white border border-gray-200 rounded-custom px-4 py-6 text-center">No encontramos protocolos con ese nombre. Revise también la <a href="/funcionarios/calidad.html" class="text-indigo-700 font-bold hover:underline">sección Calidad</a>.</p>

  <p class="text-xs text-gray-500">¿Falta un protocolo o hay una versión más nueva? Avise a la Subdirección Médica o a la Unidad de Calidad para actualizar esta página.</p>
</div>

<dialog id="dlg-protocolo" class="rounded-custom shadow-xl p-0 w-[min(620px,calc(100vw-2rem))] backdrop:bg-black/40">
  <form method="dialog" id="form-protocolo" class="flex flex-col" novalidate>
    <div class="px-6 py-4 border-b border-gray-100 border-l-4 border-l-indigo-700 flex items-center justify-between">
      <h2 class="font-bold text-primary-deep" data-titulo-dlg>Subir protocolo</h2>
      <button type="button" data-cancelar class="text-gray-400 hover:text-gray-700" aria-label="Cerrar"><span aria-hidden="true" class="material-symbols-outlined">close</span></button>
    </div>
    <div class="px-6 py-5 grid grid-cols-1 sm:grid-cols-6 gap-4 max-h-[70vh] overflow-y-auto">
      <div class="sm:col-span-6">
        <label for="p-titulo" class="block text-xs font-bold text-gray-600 mb-1">Nombre del protocolo</label>
        <input id="p-titulo" name="titulo" required maxlength="150" class="w-full border-gray-300 rounded-custom text-sm" placeholder="Ej.: Manejo de la hemorragia postparto">
      </div>
      <div class="sm:col-span-3">
        <label for="p-area" class="block text-xs font-bold text-gray-600 mb-1">Área</label>
        <select id="p-area" name="area" class="w-full border-gray-300 rounded-custom text-sm"></select>
      </div>
      <div class="sm:col-span-3">
        <label for="p-codigo" class="block text-xs font-bold text-gray-600 mb-1">Código / ámbito <span class="font-normal text-gray-500">(opcional)</span></label>
        <input id="p-codigo" name="codigo" maxlength="20" class="w-full border-gray-300 rounded-custom text-sm" placeholder="Ej.: GCL 1.2">
      </div>
      <div class="sm:col-span-3">
        <label for="p-version" class="block text-xs font-bold text-gray-600 mb-1">Versión <span class="font-normal text-gray-500">(opcional)</span></label>
        <input id="p-version" name="version" maxlength="20" class="w-full border-gray-300 rounded-custom text-sm" placeholder="Ej.: 3">
      </div>
      <div class="sm:col-span-3">
        <label for="p-vigencia" class="block text-xs font-bold text-gray-600 mb-1">Vigente hasta <span class="font-normal text-gray-500">(opcional)</span></label>
        <input id="p-vigencia" name="vigencia" type="date" class="w-full border-gray-300 rounded-custom text-sm">
      </div>
      <fieldset class="sm:col-span-6 border border-gray-200 rounded-custom px-4 py-3">
        <legend class="text-xs font-bold text-gray-600 px-1">Documento</legend>
        <div data-archivo-actual class="hidden mb-3 flex items-center gap-2 text-sm"></div>
        <label for="p-archivo" class="block text-xs font-bold text-gray-600 mb-1" data-etiqueta-archivo>Archivo PDF o Word (hasta 30 MB)</label>
        <input id="p-archivo" type="file" accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document" class="text-sm w-full">
        <p class="text-[11px] text-gray-500 mt-1">Si sube una versión nueva, la anterior queda guardada en "Versiones anteriores".</p>
        <label for="p-url" class="block text-xs font-bold text-gray-600 mt-3 mb-1">… o enlace (Google Drive u otro) <span class="font-normal text-gray-500">(opcional si sube archivo)</span></label>
        <input id="p-url" name="url" type="url" maxlength="500" class="w-full border-gray-300 rounded-custom text-sm" placeholder="https://drive.google.com/…">
      </fieldset>
      <div data-anteriores class="hidden sm:col-span-6 text-sm"></div>
      <p data-msg-dlg role="alert" class="hidden sm:col-span-6 text-sm rounded-custom px-4 py-3"></p>
    </div>
    <div class="px-6 py-4 border-t border-gray-100 flex flex-wrap items-center gap-3">
      <button type="button" data-eliminar class="hidden text-sm font-bold text-red-700 hover:underline mr-auto">Eliminar protocolo</button>
      <button type="button" data-cancelar class="ml-auto text-sm font-bold text-gray-600 px-4 py-2 hover:bg-gray-100 rounded-custom">Cancelar</button>
      <button type="submit" class="bg-indigo-700 hover:bg-indigo-800 disabled:opacity-60 text-white font-bold text-sm px-5 py-2 rounded-custom shadow" data-guardar>Guardar</button>
    </div>
  </form>
</dialog>
