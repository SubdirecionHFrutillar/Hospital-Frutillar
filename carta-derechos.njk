---
layout: base.njk
title: Carta de Derechos y Deberes
description: "Sus derechos y deberes como paciente según la Ley 20.584 en el Hospital de Frutillar."
permalink: carta-derechos.html
---
{% import "componentes.njk" as ui with context %}

{{ ui.banner(carta_derechos.titulo, carta_derechos.intro, "policy", [{ label: "Información al Usuario", url: "/horarios.html" }, { label: "Carta de Derechos y Deberes" }]) }}

{% call ui.dosColumnas() %}
  <div class="min-w-0 flex flex-col gap-6">

    {% call ui.seccion("Sus Derechos como Paciente", "verified_user", padding="px-6 py-6 flex flex-col gap-3") %}
      <p class="text-sm text-gray-600 leading-relaxed">La <strong class="text-primary">Ley N° 20.584</strong> garantiza los siguientes derechos a toda persona en su atención de salud:</p>
      <ol class="flex flex-col gap-3">
        {% for d in carta_derechos.derechos %}
        <li class="flex items-start gap-3">
          <span aria-hidden="true" class="flex-shrink-0 w-6 h-6 rounded-full bg-primary text-white text-xs font-bold flex items-center justify-center mt-0.5">{{ loop.index }}</span>
          <div>
            <p class="text-sm font-semibold text-gray-800">{{ d.titulo }}</p>
            <p class="text-sm text-gray-600">{{ d.descripcion }}</p>
          </div>
        </li>
        {% endfor %}
      </ol>
      <a href="https://www.bcn.cl/leychile/navegar?idLey=20584" target="_blank" rel="noopener" class="inline-flex items-center gap-2 bg-gray-100 text-primary text-sm font-bold px-4 py-2.5 rounded-custom hover:bg-primary-bg transition-colors w-fit border border-gray-200 mt-2">
        <span aria-hidden="true" class="material-symbols-outlined text-base">open_in_new</span>Texto completo de la Ley 20.584
      </a>
    {% endcall %}

    {% call ui.seccion("Sus Deberes como Paciente", "assignment", oscuro=true) %}
      <ul class="flex flex-col gap-3">
        {% for d in carta_derechos.deberes %}
        <li class="flex items-start gap-3 text-sm">
          <span aria-hidden="true" class="material-symbols-outlined text-primary-light text-base mt-0.5 flex-shrink-0">check_circle</span>
          <span class="text-gray-700"><strong class="text-gray-800">{{ d.titulo }}:</strong> {{ d.descripcion }}</span>
        </li>
        {% endfor %}
      </ul>
    {% endcall %}

    <div class="bg-primary-bg border border-primary-pale rounded-custom p-5 flex items-start gap-3">
      <span aria-hidden="true" class="material-symbols-outlined text-primary mt-0.5 flex-shrink-0">support_agent</span>
      <div>
        <p class="text-sm font-bold text-primary mb-1">OIRS — Oficina de Informaciones, Reclamos y Sugerencias</p>
        <p class="text-sm text-gray-700">{{ carta_derechos.oirs_descripcion }}</p>
      </div>
    </div>
  </div>

  <aside class="flex flex-col gap-5">
    {{ ui.menuLateral("Información al Usuario", (nav | buscar("id", "info")).items) }}
    {{ ui.saludResponde() }}
  </aside>
{% endcall %}
