---
layout: base.njk
title: Noticias
description: "Últimas noticias e información del Hospital de Frutillar, Servicio de Salud Reloncaví."
permalink: noticias.html
---
{% import "componentes.njk" as ui with context %}

{{ ui.banner("Noticias", "Novedades e información institucional del Hospital de Frutillar", "newspaper", [{ label: "Noticias" }]) }}

<div class="container mx-auto px-4 py-10">
  {% if collections.noticias.length %}
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    {% for n in collections.noticias %}{{ ui.tarjetaNoticia(n) }}{% endfor %}
  </div>
  {% else %}
  <p class="text-gray-500 text-center py-16">No hay noticias publicadas aún.</p>
  {% endif %}
</div>
