---
layout: base.njk
title: Quiénes Somos
description: "Misión, visión, historia y autoridades del Hospital de Frutillar."
permalink: quienes-somos.html
secciones:
  - { label: "Misión", url: "#mision", icon: "flag" }
  - { label: "Visión", url: "#vision", icon: "visibility" }
  - { label: "Historia del Hospital", url: "#historia", icon: "history_edu" }
  - { label: "Autoridades", url: "#autoridades", icon: "groups" }
  - { label: "Plan Estratégico", url: "#plan-estrategico", icon: "analytics" }
fechasClave:
  - ["1952", "Inicio de la construcción"]
  - ["1957", "Inauguración oficial del hospital"]
  - ["1957", "Primeros servicios: Pediatría y Maternidad"]
---
{% import "componentes.njk" as ui with context %}

{{ ui.banner("Quiénes Somos", "Misión, visión, historia y autoridades del Hospital de Frutillar", "groups", [{ label: "Quiénes Somos" }]) }}

{% call ui.dosColumnas() %}
  <div class="min-w-0 flex flex-col gap-7">

    {% call ui.seccion("Misión", "flag", "mision", padding="px-6 py-5") %}
      <p class="text-gray-700 leading-relaxed text-sm">{{ quienes_somos.mision }}</p>
    {% endcall %}

    {% call ui.seccion("Visión", "visibility", "vision", padding="px-6 py-5") %}
      <p class="text-gray-700 leading-relaxed text-sm">{{ quienes_somos.vision }}</p>
    {% endcall %}

    {% call ui.seccion("Historia del Hospital", "history_edu", "historia") %}
      <div class="prose max-w-none text-sm text-gray-700 leading-relaxed">{{ quienes_somos.historia | markdown | safe }}</div>
    {% endcall %}

    {% call ui.seccion("Autoridades", "groups", "autoridades") %}
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {% for a in quienes_somos.autoridades %}
        <div class="flex items-start gap-4 bg-gray-50 border border-gray-100 rounded-custom p-4">
          <div class="w-12 h-12 rounded-full bg-primary flex items-center justify-center flex-shrink-0 overflow-hidden">
            {% if a.foto %}
              <img src="{{ a.foto }}" alt="" class="w-full h-full object-cover">
            {% else %}
              <span aria-hidden="true" class="material-symbols-outlined text-white text-xl">person</span>
            {% endif %}
          </div>
          <div>
            <p class="text-xs font-bold text-primary-light uppercase tracking-wide mb-0.5">{{ a.cargo }}</p>
            <p class="text-sm font-semibold text-gray-800">{{ a.nombre }}</p>
            <p class="text-xs text-gray-500">{{ a.unidad }}</p>
          </div>
        </div>
        {% endfor %}
      </div>
    {% endcall %}

    {% call ui.seccion("Plan Estratégico", "analytics", "plan-estrategico") %}
      <div class="prose max-w-none text-sm text-gray-700 leading-relaxed">{{ quienes_somos.plan_estrategico | markdown | safe }}</div>
    {% endcall %}

  </div>

  <aside class="flex flex-col gap-5">
    {{ ui.menuLateral("En esta sección", secciones) }}

    <div class="bg-white border border-gray-200 rounded-custom shadow-sm overflow-hidden">
      <div class="bg-primary-dark text-white text-xs font-bold uppercase tracking-widest px-4 py-2.5">Fechas Clave</div>
      <ol class="px-4 py-4 flex flex-col gap-3 divide-y divide-gray-100">
        {% for f in fechasClave %}
        <li class="flex items-start gap-3{% if not loop.first %} pt-3{% endif %}">
          <span class="text-primary-light font-black text-sm whitespace-nowrap">{{ f[0] }}</span>
          <p class="text-xs text-gray-600">{{ f[1] }}</p>
        </li>
        {% endfor %}
      </ol>
    </div>

    {{ ui.saludResponde() }}
  </aside>
{% endcall %}
