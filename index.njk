---
layout: base.njk
permalink: index.html
title: Inicio
portada: true
accesosUsuarios:
  - { titulo: "Ver Imágenes de Exámenes", texto: "Accede a tus imágenes de radiología, ecografía y otros exámenes en línea", url: "https://examenes.ssdr.gob.cl/login", externo: true, icono: "radiology", cta: "Acceder", fondo: "bg-primary-bg border-primary-pale hover:border-primary-light", circulo: "bg-primary", color: "text-primary" }
  - { titulo: "¿Urgencia o CESFAM?", texto: "Dónde consultar según su problema y cómo se prioriza la atención en Urgencia", url: "/donde-consultar.html", icono: "alt_route", cta: "Ver guía", fondo: "bg-red-50 border-red-100", circulo: "bg-red-600", color: "text-red-600" }
  - { titulo: "OIRS", texto: "Oficina de Información, Reclamos y Sugerencias. Haz llegar tu opinión o reclamo.", url: "/contacto.html", icono: "campaign", cta: "Contactar", fondo: "bg-teal-50 border-teal-100", circulo: "bg-teal-600", color: "text-teal-600" }
  - { titulo: "Preguntas Frecuentes", texto: "Respuestas sobre atención, horarios, pagos FONASA y trámites en el hospital", url: "/faq.html", icono: "help", cta: "Ver respuestas", fondo: "bg-purple-50 border-purple-100", circulo: "bg-purple-600", color: "text-purple-600" }
accesosRapidos:
  - { titulo: "Urgencias", texto: "Atención 24 horas y categorización", url: "/donde-consultar.html#categorizacion", icono: "emergency", tono: "bg-red-50 text-red-500" }
  - { titulo: "Visitas a hospitalizados", texto: "Todos los días, 10:00 a 19:00 hrs", url: "/visitas.html", icono: "groups", tono: "bg-amber-50 text-amber-600" }
  - { titulo: "Horarios de Atención", texto: "Consultas y especialidades", url: "/horarios.html", icono: "schedule", tono: "bg-primary-bg text-primary" }
  - { titulo: "Imagenología", texto: "Ver exámenes en línea", url: "https://examenes.ssdr.gob.cl/login", externo: true, icono: "radiology", tono: "bg-indigo-50 text-indigo-600" }
  - { titulo: "Teléfonos del Hospital", texto: "Contacto y cómo llegar", url: "/contacto.html", icono: "call", tono: "bg-green-50 text-green-600" }
---
{% import "componentes.njk" as ui with context %}
{% from "campana-arte.njk" import arte %}

<!-- ATENCIÓN DE USUARIOS -->
<section class="bg-white border-b border-gray-200 py-10" aria-labelledby="titulo-atencion">
  <div class="container mx-auto px-4">
    <div class="flex items-center gap-3 mb-7">
      <span aria-hidden="true" class="material-symbols-outlined text-primary-light text-2xl">support_agent</span>
      <h2 id="titulo-atencion" class="text-2xl font-bold text-primary">Atención de Usuarios</h2>
      <div class="h-px bg-gray-200 flex-1"></div>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {% for a in accesosUsuarios %}
      <a href="{{ a.url }}"{% if a.externo %} target="_blank" rel="noopener"{% endif %} class="group {{ a.fondo }} border rounded-custom p-5 flex flex-col gap-3 hover:shadow-md transition-all">
        <div class="w-12 h-12 {{ a.circulo }} rounded-full flex items-center justify-center flex-shrink-0">
          <span aria-hidden="true" class="material-symbols-outlined text-white text-2xl">{{ a.icono }}</span>
        </div>
        <div class="flex-1">
          <h3 class="font-bold text-gray-900 text-sm leading-tight mb-1">{{ a.titulo }}</h3>
          <p class="text-xs text-gray-500 leading-relaxed">{{ a.texto }}</p>
        </div>
        <span class="text-xs font-bold {{ a.color }} group-hover:underline">{{ a.cta }} →</span>
      </a>
      {% endfor %}
    </div>
  </div>
</section>

{% call ui.dosColumnas() %}
  <div class="min-w-0 flex flex-col gap-5">

    {% include "campana-rotativa.njk" %}

    <!-- NOTICIAS -->
    <section aria-labelledby="titulo-noticias">
      <div class="flex items-center gap-3 mb-4">
        <h2 id="titulo-noticias" class="text-2xl font-bold text-primary border-l-4 border-primary-light pl-3">Últimas Noticias</h2>
        <div class="h-px bg-gray-200 flex-1"></div>
      </div>

      <div class="flex flex-col gap-3">
        {% for n in collections.noticiasPortada %}
          {% if loop.first %}
          <article class="news-card bg-white rounded-custom shadow-md overflow-hidden">
            <div class="bg-noticia relative h-52 md:h-60 overflow-hidden">
              {% if n.data.imagen %}
                <img src="{{ n.data.imagen | imagenCdn(1000) }}" onerror="this.onerror=null;this.src='{{ n.data.imagen }}'" alt="" decoding="async" class="w-full h-full object-cover">
              {% else %}
                <div class="absolute inset-0 flex items-center justify-center" aria-hidden="true">
                  <span class="material-symbols-outlined text-white/10 text-[160px] leading-none">article</span>
                </div>
              {% endif %}
              <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>
              <span class="absolute top-3 left-3 px-2.5 py-1 bg-primary text-white text-[10px] font-bold uppercase tracking-wider rounded shadow-md">{{ n.data.categoria }}</span>
              <div class="absolute bottom-3 left-4 flex items-center gap-1.5 text-white/80 text-xs">
                <span aria-hidden="true" class="material-symbols-outlined text-sm">calendar_today</span>
                <time datetime="{{ n.date | fechaISO }}">{{ n.date | fechaES }}</time>
              </div>
            </div>
            <div class="p-5">
              <h3 class="text-xl md:text-2xl font-bold text-gray-900 leading-snug mb-2">{{ n.data.title }}</h3>
              <p class="text-sm text-gray-500 leading-relaxed mb-4">{{ n.data.resumen }}</p>
              <a href="{{ n.url }}" class="inline-flex items-center gap-2 bg-primary hover:bg-primary-dark text-white text-sm font-bold px-4 py-2 rounded-custom transition-colors">
                Leer noticia <span aria-hidden="true" class="material-symbols-outlined text-base">arrow_forward</span>
              </a>
            </div>
          </article>
          {% else %}
          <article class="news-card bg-white rounded-custom shadow-sm p-4 flex gap-4">
            <div class="w-11 h-11 rounded-custom bg-primary-bg flex items-center justify-center flex-shrink-0">
              <span aria-hidden="true" class="material-symbols-outlined text-primary text-2xl">article</span>
            </div>
            <div class="flex flex-col justify-center gap-1">
              <span class="px-2 py-0.5 bg-primary-bg text-primary text-[10px] font-bold uppercase tracking-wide rounded w-fit">{{ n.data.categoria }}</span>
              <h3 class="font-bold text-gray-800 text-sm leading-snug">{{ n.data.title }}</h3>
              <div class="flex items-center gap-3">
                <time datetime="{{ n.date | fechaISO }}" class="text-xs text-gray-400">{{ n.date | fechaES }}</time>
                <a href="{{ n.url }}" class="text-xs font-bold text-primary hover:underline">Leer más<span class="sr-only">: {{ n.data.title }}</span> →</a>
              </div>
            </div>
          </article>
          {% endif %}
        {% else %}
          <p class="text-gray-500 text-center py-10">No hay noticias publicadas aún.</p>
        {% endfor %}
      </div>

      <a href="/noticias.html" class="mt-4 flex items-center justify-center gap-2 w-full py-2.5 bg-white border border-gray-200 rounded-custom text-primary text-sm font-bold hover:bg-primary-bg transition-colors shadow-sm">
        <span aria-hidden="true" class="material-symbols-outlined text-base">add</span>Ver todas las noticias
      </a>
    </section>
  </div>

  <!-- BARRA LATERAL -->
  <aside class="flex flex-col gap-5">
    <div class="bg-white border border-gray-200 rounded-custom shadow-sm overflow-hidden">
      <div class="bg-primary-dark text-white text-xs font-bold uppercase tracking-widest px-4 py-2.5 flex items-center gap-2">
        <span aria-hidden="true" class="material-symbols-outlined text-base text-primary-light">bolt</span>Accesos Rápidos
      </div>
      <div class="flex flex-col divide-y divide-gray-100">
        {% for a in accesosRapidos %}
        <a href="{{ a.url }}"{% if a.externo %} target="_blank" rel="noopener"{% endif %} class="acceso-item flex items-center gap-3 px-4 py-3">
          <div class="w-9 h-9 rounded-full flex items-center justify-center flex-shrink-0 {{ a.tono }}"><span aria-hidden="true" class="material-symbols-outlined text-lg">{{ a.icono }}</span></div>
          <div><strong class="text-sm text-primary block">{{ a.titulo }}</strong><span class="text-xs text-gray-500">{{ a.texto }}</span></div>
        </a>
        {% endfor %}
      </div>
    </div>

    <div class="flex flex-col gap-2">
      <h2 class="text-sm font-bold text-gray-600 mt-1">Campañas del Ministerio de Salud</h2>
      {% for c in campanas.campanas %}
      <a href="{{ c.url }}" target="_blank" rel="noopener" class="campana group{% if c.destacada %} campana--destacada{% endif %}" style="--campana: {{ c.color }}; color: {{ c.color }};">
        {% if c.imagen %}
          <img src="{{ c.imagen }}" alt="{{ c.titular }}" loading="lazy" class="w-full h-auto block">
        {% else %}
        <span class="campana__arte">{{ arte(c.arte) }}</span>
        <span class="campana__texto">
          {% if c.dato %}<span class="campana__dato">{{ c.dato }}</span>{% endif %}
          <span class="campana__titular">{{ c.titular }}</span>
          <span class="campana__bajada">{{ c.texto }}</span>
        </span>
        {% endif %}
        <span class="sr-only">(se abre en el sitio del Ministerio de Salud)</span>
      </a>
      {% endfor %}
      {{ ui.saludResponde() }}
    </div>
  </aside>
{% endcall %}

<!-- CÓMO LLEGAR -->
<section class="bg-white border-t border-gray-200 py-10" aria-labelledby="titulo-llegar">
  <div class="container mx-auto px-4 grid grid-cols-1 lg:grid-cols-[1fr_340px] gap-6 items-stretch">
    <div class="rounded-custom overflow-hidden border border-gray-200 shadow-sm min-h-[300px] bg-gray-100">
      <iframe src="{{ site.mapsEmbed }}" title="Mapa de ubicación del {{ site.name }}" loading="lazy" referrerpolicy="no-referrer-when-downgrade" class="w-full h-full min-h-[300px] border-0"></iframe>
    </div>
    <div class="flex flex-col gap-4">
      <div>
        <h2 id="titulo-llegar" class="text-2xl font-bold text-primary-deep">Cómo llegar</h2>
        <div class="gob-barra mt-3" aria-hidden="true"></div>
      </div>
      <p class="flex items-start gap-2 text-gray-800"><span aria-hidden="true" class="material-symbols-outlined text-primary">location_on</span><span><strong>{{ site.direccion }}</strong><br><span class="text-sm text-gray-500">{{ site.region }}, Chile</span></span></p>
      <p class="flex items-start gap-2 text-gray-800"><span aria-hidden="true" class="material-symbols-outlined text-primary">call</span><span><a href="{{ site.telefonoCentralHref }}" class="font-bold hover:underline">{{ site.telefonoCentral }}</a><br><span class="text-sm text-gray-500">Central telefónica</span></span></p>
      <p class="flex items-start gap-2 text-gray-800"><span aria-hidden="true" class="material-symbols-outlined text-red-600">emergency</span><span><strong>Urgencia 24 horas</strong><br><span class="text-sm text-gray-500">Emergencia vital: llame al <a href="tel:131" class="font-bold text-gray-800 hover:underline">131</a></span></span></p>
      <div class="flex flex-wrap gap-2 mt-auto">
        <a href="{{ site.mapsUrl }}" target="_blank" rel="noopener" class="inline-flex items-center gap-2 bg-primary hover:bg-primary-dark text-white text-sm font-bold px-4 py-2.5 rounded-custom"><span aria-hidden="true" class="material-symbols-outlined text-base">directions</span>Abrir en Google Maps</a>
        <a href="/contacto.html" class="inline-flex items-center gap-2 border border-primary-pale bg-primary-bg text-primary text-sm font-bold px-4 py-2.5 rounded-custom hover:bg-primary-pale">Contacto</a>
      </div>
    </div>
  </div>
</section>
