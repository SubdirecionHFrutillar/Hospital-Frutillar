---
layout: base.njk
title: Transparencia
description: "Transparencia activa y pasiva del Hospital de Frutillar. Acceso a información pública, presupuestos, auditorías y más."
permalink: transparencia.html
---
{% import "componentes.njk" as ui with context %}

{{ ui.banner("Transparencia", "Acceso a la información pública del Hospital de Frutillar según Ley 20.285", "account_balance", [{ label: "Transparencia" }]) }}

{% call ui.dosColumnas() %}
  <div class="min-w-0 flex flex-col gap-6">
    {{ ui.aviso(transparencia.intro) }}

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {% for s in transparencia.secciones %}
      {% set externo = s.enlace and s.enlace.startsWith("http") %}
      <div id="{{ s.id }}" class="scroll-mt-24 bg-white border border-gray-200 rounded-custom shadow-sm overflow-hidden hover:shadow-md transition-shadow flex flex-col">
        <div class="px-4 py-3 flex items-center gap-2 border-b border-gray-100 border-l-4 border-l-primary">
          <span aria-hidden="true" class="material-symbols-outlined text-primary text-xl">{{ s.icon }}</span>
          <h2 class="text-primary-deep font-bold text-sm tracking-wide">{{ s.titulo }}</h2>
        </div>
        <div class="px-4 py-4 flex-1 flex flex-col gap-3">
          <div class="prose max-w-none text-sm text-gray-700 leading-relaxed flex-1">{{ s.descripcion | markdown | safe }}</div>
          {% if s.enlace %}
          <a href="{{ s.enlace }}"{% if externo %} target="_blank" rel="noopener"{% endif %} class="mt-auto inline-flex items-center gap-2 bg-primary-bg text-primary border border-primary-pale text-xs font-bold px-3 py-2 rounded-custom hover:bg-primary-pale transition-colors w-fit">
            <span aria-hidden="true" class="material-symbols-outlined text-base">{{ "open_in_new" if externo else "arrow_forward" }}</span>
            {{ s.enlace_texto or "Ver más" }}
          </a>
          {% endif %}
        </div>
      </div>
      {% endfor %}
    </div>
  </div>

  <aside class="flex flex-col gap-5">
    {% set menuTransp = [] %}
    {% for s in transparencia.secciones %}{% set menuTransp = (menuTransp.push({ label: s.titulo, url: "#" + s.id, icon: s.icon }), menuTransp) %}{% endfor %}
    {{ ui.menuLateral("Secciones", menuTransp) }}
    {{ ui.enlacesExternos("Recursos Externos", [
      { label: "Consejo para la Transparencia", url: "https://www.consejotransparencia.cl" },
      { label: "Servicio de Salud Reloncaví", url: site.ssreloncavi },
      { label: "Ministerio de Salud", url: "https://www.minsal.cl" }
    ]) }}
    {{ ui.saludResponde() }}
  </aside>
{% endcall %}
