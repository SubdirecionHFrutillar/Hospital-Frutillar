{# Tarjeta de un ámbito o tema de Calidad. Usa la variable "item". #}
<article class="calidad-ambito">
  <header class="flex items-start gap-3">
    <span class="calidad-ambito__icono" aria-hidden="true"><span class="material-symbols-outlined">{{ item.icono }}</span></span>
    <div class="flex-1 min-w-0">
      <h3 class="font-bold text-primary-deep leading-tight">{% if item.sigla %}<span class="calidad-ambito__sigla">{{ item.sigla }}</span> {% endif %}{{ item.nombre }}</h3>
      <p class="text-xs text-gray-500 leading-snug mt-1">{{ item.descripcion }}</p>
    </div>
  </header>
  {% if item.documentos.length %}
  <ul class="mt-3 flex flex-col divide-y divide-gray-100 border-t border-gray-100">
    {% for d in item.documentos %}
    <li><a href="{{ d.url }}" target="_blank" rel="noopener" class="flex items-center gap-2 py-2 text-[13px] text-gray-800 hover:text-primary"><span aria-hidden="true" class="material-symbols-outlined text-base text-teal-700">description</span><span class="flex-1">{{ d.titulo }}</span>{% if d.codigo %}<span class="text-[11px] text-gray-400">{{ d.codigo }}</span>{% endif %}</a></li>
    {% endfor %}
  </ul>
  {% endif %}
  {% if item.url %}
  <a href="{{ item.url }}" target="_blank" rel="noopener" class="mt-auto pt-3 inline-flex items-center gap-1.5 text-xs font-bold text-teal-700 hover:underline">
    {{ "Ver carpeta" if item.documentos.length else "Ver documentos" }} <span aria-hidden="true" class="material-symbols-outlined text-sm">open_in_new</span>
  </a>
  {% endif %}
</article>
