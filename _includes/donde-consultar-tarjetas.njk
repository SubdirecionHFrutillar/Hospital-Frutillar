{# Tres opciones de atención (131 / Urgencia / CESFAM). Se usa en la portada y en /donde-consultar.html. #}
<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
  {% for o in donde_consultar.opciones %}
  <div class="consulta consulta--{{ o.tono }}">
    <div class="flex items-center gap-3">
      <span class="consulta__icono" aria-hidden="true"><span class="material-symbols-outlined text-2xl">{{ o.icono }}</span></span>
      <div>
        <h3 class="font-bold text-base leading-tight text-gray-900">{{ o.titulo }}</h3>
        <p class="consulta__accion">{{ o.accion }}</p>
      </div>
    </div>
    <ul class="mt-3 flex flex-col gap-1.5 text-[13px] text-gray-700 leading-snug">
      {% for e in o.ejemplos %}<li class="flex gap-2"><span aria-hidden="true" class="consulta__punto"></span><span>{{ e }}</span></li>{% endfor %}
    </ul>
  </div>
  {% endfor %}
</div>
