{#
  Ilustraciones de las campañas de salud (SVG en línea, sin dependencias).
  Cada campaña tiene su propio dibujo; se elige con el campo "arte" en _data/campanas.json.
  Se dibujan en blanco sobre el color de la campaña y quedan recortadas por el borde derecho.
#}
{% macro arte(clave) %}
<svg viewBox="0 0 120 120" class="w-full h-full" aria-hidden="true" focusable="false" fill="none" stroke="#fff" stroke-linecap="round" stroke-linejoin="round">
{% if clave == "vacuna" %}
  {# Jeringa en diagonal sobre un escudo #}
  <path d="M60 14 98 28v30c0 26-17 41-38 50-21-9-38-24-38-50V28z" fill="#fff" fill-opacity=".14" stroke-opacity=".5" stroke-width="3"/>
  <g transform="rotate(-45 60 62)" stroke-width="4">
    <rect x="50" y="34" width="20" height="44" rx="3" fill="#fff" fill-opacity=".9" stroke="none"/>
    <path d="M50 46h9M50 56h9M50 66h9" stroke="currentColor" stroke-width="2.5"/>
    <path d="M60 78v18M54 30h12M60 30V20M52 20h16"/>
  </g>
{% elif clave == "sarampion" %}
  {# Niño con dos marcas de vacuna: 12 y 36 meses #}
  <circle cx="54" cy="44" r="22" fill="#fff" fill-opacity=".9" stroke="none"/>
  <path d="M20 112c0-24 15-38 34-38s34 14 34 38" fill="#fff" fill-opacity=".9" stroke="none"/>
  <circle cx="46" cy="42" r="2.6" fill="currentColor" stroke="none"/><circle cx="62" cy="42" r="2.6" fill="currentColor" stroke="none"/>
  <path d="M47 53c4 3 10 3 14 0" stroke="currentColor" stroke-width="2.5"/>
  <circle cx="88" cy="28" r="13" fill="#fff" stroke="none"/><text x="88" y="33" text-anchor="middle" font-size="14" font-weight="800" fill="currentColor" stroke="none" font-family="Barlow Condensed, Public Sans, sans-serif">1ª</text>
  <circle cx="90" cy="60" r="13" fill="#fff" stroke="none"/><text x="90" y="65" text-anchor="middle" font-size="14" font-weight="800" fill="currentColor" stroke="none" font-family="Barlow Condensed, Public Sans, sans-serif">2ª</text>
{% elif clave == "oncologia" %}
  {# Lupa sobre células: detección temprana #}
  <g fill="#fff" fill-opacity=".22" stroke-opacity=".55" stroke-width="2.5">
    <circle cx="28" cy="84" r="11"/><circle cx="52" cy="96" r="9"/><circle cx="20" cy="56" r="8"/><circle cx="92" cy="98" r="8"/>
  </g>
  <circle cx="64" cy="50" r="28" fill="#fff" fill-opacity=".9" stroke="none"/>
  <circle cx="64" cy="50" r="28" stroke-width="6"/>
  <circle cx="58" cy="46" r="8" fill="currentColor" fill-opacity=".85" stroke="none"/><circle cx="73" cy="58" r="5" fill="currentColor" fill-opacity=".5" stroke="none"/>
  <path d="M85 72 106 94" stroke-width="10"/>
{% elif clave == "conversacion" %}
  {# Dos globos de diálogo #}
  <path d="M14 22h58a8 8 0 0 1 8 8v30a8 8 0 0 1-8 8H38l-14 13V68h-10a8 8 0 0 1-8-8V30a8 8 0 0 1 8-8z" fill="#fff" fill-opacity=".92" stroke="none"/>
  <path d="M26 40h40M26 52h28" stroke="currentColor" stroke-width="4"/>
  <path d="M60 60h44a8 8 0 0 1 8 8v24a8 8 0 0 1-8 8h-4v12l-13-12H60a8 8 0 0 1-8-8V68a8 8 0 0 1 8-8z" fill="#fff" fill-opacity=".28" stroke-width="3"/>
  <circle cx="72" cy="80" r="3" fill="#fff" stroke="none"/><circle cx="84" cy="80" r="3" fill="#fff" stroke="none"/><circle cx="96" cy="80" r="3" fill="#fff" stroke="none"/>
{% elif clave == "lazo" %}
  {# Lazo de la prevención del VIH #}
  <path d="M60 18c-14 0-22 10-22 22 0 9 4 16 9 24L22 104l14 8 24-38 24 38 14-8-25-40c5-8 9-15 9-24 0-12-8-22-22-22zm0 14c6 0 9 4 9 9 0 5-3 11-9 19-6-8-9-14-9-19 0-5 3-9 9-9z" fill="#fff" fill-opacity=".92" stroke="none"/>
{% elif clave == "donacion" %}
  {# Mano abierta que ofrece un corazón #}
  <path d="M58 58 40 40a12 12 0 0 1 18-16 12 12 0 0 1 18 16z" fill="#fff" stroke="none"/>
  <path d="M10 76h22l10 6h22c6 0 6 9 0 9H46" stroke-width="6"/>
  <path d="M10 104h38l40-14c8-3 5-13-3-11L64 86" stroke-width="6"/>
  <path d="M10 70v40" stroke-width="8" stroke-opacity=".6"/>
{% elif clave == "tabaco" %}
  {# Señal de prohibido fumar #}
  <rect x="22" y="54" width="54" height="13" rx="2" fill="#fff" fill-opacity=".92" stroke="none"/>
  <rect x="78" y="54" width="14" height="13" rx="2" fill="#fff" fill-opacity=".5" stroke="none"/>
  <path d="M84 48c5-5 0-10 5-15" stroke-width="3" stroke-opacity=".5"/>
  <circle cx="60" cy="60" r="44" stroke-width="8"/>
  <path d="M29 29 91 91" stroke-width="8"/>
{% elif clave == "hanta" %}
  {# Carpa, pino y ratón: zona rural y camping #}
  <path d="M18 104 38 46l20 58z" fill="#fff" fill-opacity=".9" stroke="none"/>
  <path d="M38 46v58" stroke="currentColor" stroke-width="3"/>
  <path d="M84 104V86M84 20l-16 26h8l-12 18h9l-11 20h44l-11-20h9L92 46h8z" fill="#fff" fill-opacity=".55" stroke="none"/>
  <path d="M60 106h56" stroke-width="3" stroke-opacity=".7"/>
{% elif clave == "ventilar" %}
  {# Ventana abierta con aire #}
  <rect x="20" y="22" width="56" height="76" rx="3" stroke-width="7"/>
  <path d="M20 22 46 34v76L20 98" fill="#fff" fill-opacity=".35" stroke-width="5"/>
  <path d="M74 44c12 0 12-10 24-10M74 60c14 0 14-10 30-10M74 76c12 0 12-10 24-10" stroke-width="6"/>
{% elif clave == "frasco" %}
  {# Envase hermético #}
  <rect x="30" y="18" width="60" height="16" rx="3" fill="#fff" stroke="none"/>
  <path d="M34 34h52v62a10 10 0 0 1-10 10H44a10 10 0 0 1-10-10z" stroke-width="7"/>
  <path d="M46 62h28M46 78h20" stroke-width="6"/>
{% elif clave == "carpa" %}
  {# Carpa con piso #}
  <path d="M12 96 60 22l48 74z" stroke-width="7"/>
  <path d="M60 22v74M46 96l14-30 14 30" stroke-width="6"/>
  <path d="M6 104h108" stroke-width="7"/>
{% elif clave == "sol" %}
  {# Sol con rayos #}
  <circle cx="60" cy="60" r="22" fill="#fff" fill-opacity=".92" stroke="none"/>
  <path d="M60 14v14M60 92v14M14 60h14M92 60h14M27 27l10 10M83 83l10 10M27 93l10-10M83 37l10-10" stroke-width="7"/>
{% elif clave == "agua" %}
  {# Vaso con agua #}
  <path d="M30 20h60l-8 84a6 6 0 0 1-6 5H44a6 6 0 0 1-6-5z" stroke-width="7"/>
  <path d="M36 52h48l-5 50H41z" fill="#fff" fill-opacity=".6" stroke="none"/>
{% elif clave == "gorro" %}
  {# Sombrero de ala ancha #}
  <path d="M38 70c0-22 8-40 22-40s22 18 22 40" fill="#fff" fill-opacity=".9" stroke="none"/>
  <path d="M8 76c20 10 84 10 104 0" stroke-width="8"/>
{% elif clave == "manos" %}
  {# Gotas y manos (lavado) #}
  <path d="M60 14c10 14 16 24 16 32a16 16 0 0 1-32 0c0-8 6-18 16-32z" fill="#fff" fill-opacity=".9" stroke="none"/>
  <path d="M20 106V82c0-6 8-6 8 0v-8c0-6 8-6 8 0v4c0-6 8-6 8 0v28M100 106V82c0-6-8-6-8 0v-8c0-6-8-6-8 0v4c0-6-8-6-8 0v28" stroke-width="6"/>
{% elif clave == "pulmon" %}
  {# Pulmones #}
  <path d="M60 18v40M60 58c-6-4-12-4-14 2" stroke-width="6"/>
  <path d="M46 40c-14 0-30 26-30 50 0 12 8 18 18 16 10-2 16-8 16-20V48c0-5-1-8-4-8z" fill="#fff" fill-opacity=".9" stroke="none"/>
  <path d="M74 40c14 0 30 26 30 50 0 12-8 18-18 16-10-2-16-8-16-20V48c0-5 1-8 4-8z" fill="#fff" fill-opacity=".9" stroke="none"/>
{% elif clave == "casa" %}
  {# Casa con cruz: hospitalización domiciliaria #}
  <path d="M14 58 60 20l46 38v50H14z" fill="#fff" fill-opacity=".92" stroke="none"/>
  <path d="M60 50v34M43 67h34" stroke="currentColor" stroke-width="10"/>
{% elif clave == "marea" %}
  {# Concha de bivalvo sobre olas: marea roja #}
  <path d="M60 22c-24 0-40 18-40 38 0 6 2 10 6 12h68c4-2 6-6 6-12 0-20-16-38-40-38z" fill="#fff" fill-opacity=".92" stroke="none"/>
  <path d="M60 26v44M46 30l8 40M74 30l-8 40M34 40l14 30M86 40 72 70" stroke="currentColor" stroke-width="3"/>
  <path d="M8 90c10-8 18-8 28 0s18 8 28 0 18-8 28 0 14 6 20 2M8 106c10-8 18-8 28 0s18 8 28 0 18-8 28 0 14 6 20 2" stroke-width="6" stroke-opacity=".75"/>
{% elif clave == "olla" %}
  {# Olla hirviendo #}
  <path d="M38 30c-4-6 4-10 0-16M60 30c-4-6 4-10 0-16M82 30c-4-6 4-10 0-16" stroke-width="5"/>
  <path d="M20 44h80v42a14 14 0 0 1-14 14H34a14 14 0 0 1-14-14z" fill="#fff" fill-opacity=".9" stroke="none"/>
  <path d="M10 52h10M100 52h10" stroke-width="7"/>
{% elif clave == "telefono" %}
  {# Teléfono: llamar o consultar #}
  <path d="M34 16c6 0 10 14 10 20s-8 8-8 12c4 14 18 28 32 32 4 0 6-8 12-8s20 4 20 10-6 16-14 16C54 98 22 66 22 34c0-8 6-18 12-18z" fill="#fff" fill-opacity=".92" stroke="none"/>
{% elif clave == "lago" %}
  {# Olas y salvavidas: lago #}
  <circle cx="72" cy="46" r="26" stroke-width="12"/>
  <path d="M72 20v10M72 62v10M46 46h10M88 46h10" stroke="currentColor" stroke-width="8"/>
  <path d="M8 92c10-8 18-8 28 0s18 8 28 0 18-8 28 0 14 6 20 2M8 108c10-8 18-8 28 0s18 8 28 0 18-8 28 0 14 6 20 2" stroke-width="6" stroke-opacity=".75"/>
{% elif clave == "salvavidas" %}
  {# Chaleco/aro salvavidas #}
  <circle cx="60" cy="60" r="34" stroke-width="16"/>
  <path d="M60 26v14M60 80v14M26 60h14M80 60h14" stroke="currentColor" stroke-width="9"/>
{% elif clave == "estufa" %}
  {# Estufa con cañón y humo: monóxido de carbono #}
  <path d="M70 12v26" stroke-width="8"/>
  <rect x="26" y="38" width="62" height="56" rx="6" fill="#fff" fill-opacity=".92" stroke="none"/>
  <rect x="38" y="52" width="38" height="26" rx="3" stroke="currentColor" stroke-width="4"/>
  <path d="M48 72c0-8 8-10 8-16 4 4 10 8 10 16" stroke="currentColor" stroke-width="3"/>
  <path d="M32 94v10M82 94v10" stroke-width="7"/>
  <path d="M84 20c8-6 16 0 22-4M88 32c8-6 14 0 20-4" stroke-width="4" stroke-opacity=".7"/>
{% elif clave == "sello" %}
  {# Sello con visto bueno: certificación sanitaria #}
  <path d="M60 10 72 20l16-2 4 16 14 8-6 15 6 15-14 8-4 16-16-2-12 10-12-10-16 2-4-16-14-8 6-15-6-15 14-8 4-16 16 2z" fill="#fff" fill-opacity=".92" stroke="none"/>
  <path d="M42 60l12 12 24-24" stroke="currentColor" stroke-width="9"/>
{% elif clave == "cerdo" %}
  {# Cecina/longaniza con lupa: carne con control #}
  <path d="M14 70c0-10 10-16 22-16h34c12 0 22 6 22 16s-10 16-22 16H36C24 86 14 80 14 70z" fill="#fff" fill-opacity=".9" stroke="none"/>
  <path d="M34 62v16M52 62v16M70 62v16" stroke="currentColor" stroke-width="3"/>
  <circle cx="86" cy="40" r="16" stroke-width="7"/>
  <path d="M98 52l12 12" stroke-width="9"/>
{% elif clave == "hojas" %}
  {# Matorral y leña: tifus de los matorrales #}
  <path d="M30 104c0-40 10-60 30-80 20 20 30 40 30 80z" fill="#fff" fill-opacity=".9" stroke="none"/>
  <path d="M60 30v74M60 56 46 46M60 70l16-12M60 86 44 76" stroke="currentColor" stroke-width="4"/>
  <path d="M8 104h104" stroke-width="6"/>
  <path d="M10 92h28M84 92h26" stroke-width="9" stroke-opacity=".7"/>
{% elif clave == "ropa" %}
  {# Polera de manga larga #}
  <path d="M42 16 24 24 8 70l14 6 12-30v60h52V46l12 30 14-6-16-46-18-8c-2 8-10 12-18 12s-16-4-18-12z" fill="#fff" fill-opacity=".9" stroke="none"/>
{% elif clave == "termometro" %}
  {# Termómetro: fiebre #}
  <path d="M50 74V24a10 10 0 0 1 20 0v50a20 20 0 1 1-20 0z" stroke-width="7"/>
  <circle cx="60" cy="90" r="10" fill="#fff" stroke="none"/>
  <path d="M60 86V40" stroke-width="7"/>
{% endif %}
</svg>
{% endmacro %}
