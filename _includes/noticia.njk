---
layout: base.njk
---
<div class="container mx-auto px-4 py-10 max-w-3xl">
  <nav class="text-xs text-gray-500 mb-6 flex items-center gap-1.5" aria-label="Ruta de navegación">
    <a href="/" class="hover:text-primary transition-colors">Inicio</a>
    <span aria-hidden="true" class="material-symbols-outlined text-xs">chevron_right</span>
    <a href="/noticias.html" class="hover:text-primary transition-colors">Noticias</a>
    <span aria-hidden="true" class="material-symbols-outlined text-xs">chevron_right</span>
    <span class="text-gray-700 font-medium truncate max-w-[200px]" aria-current="page">{{ title }}</span>
  </nav>

  <article class="bg-white rounded-custom shadow-md overflow-hidden">
    <div class="bg-noticia relative {{ 'h-64 md:h-80' if imagen else 'h-48' }} overflow-hidden">
      {% if imagen %}
        <img src="{{ imagen }}" alt="" class="w-full h-full object-cover">
        <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent"></div>
      {% else %}
        <div class="absolute inset-0 flex items-center justify-center" aria-hidden="true">
          <span class="material-symbols-outlined text-white/10 text-[120px] leading-none">article</span>
        </div>
      {% endif %}
      <span class="absolute top-4 left-4 px-2.5 py-1 bg-primary text-white text-[10px] font-bold uppercase tracking-wider rounded shadow-md">{{ categoria }}</span>
      <div class="absolute bottom-4 left-4 flex items-center gap-1.5 text-white/80 text-xs">
        <span aria-hidden="true" class="material-symbols-outlined text-sm">calendar_today</span>
        {% set fechaN = fechaNoticia or page.date %}<time datetime="{{ fechaN | fechaISO }}">{{ fechaN | fechaES }}</time>
      </div>
    </div>

    <div class="p-6 md:p-8">
      <h2 class="text-2xl md:text-3xl font-bold text-gray-900 leading-snug mb-4">{{ title }}</h2>
      <p class="text-base text-gray-500 leading-relaxed border-l-4 border-primary-pale pl-4 mb-6">{{ resumen }}</p>
      <div class="prose max-w-none text-gray-700 leading-relaxed">{{ content | safe }}</div>
      {% if adjuntosNoticia and adjuntosNoticia.length %}
      <ul class="mt-6 flex flex-col gap-2 border-t border-gray-100 pt-5">
        {% for a in adjuntosNoticia %}
        <li>
          {% if a.tipo.startsWith("image/") %}
          <img src="/api/noticias-archivos/{{ a.id }}" alt="" loading="lazy" class="w-full rounded-custom border border-gray-200">
          {% else %}
          <a href="/api/noticias-archivos/{{ a.id }}" target="_blank" rel="noopener" class="flex items-center gap-3 border border-gray-200 rounded-custom px-4 py-3 hover:bg-primary-bg hover:border-primary-pale">
            <span aria-hidden="true" class="material-symbols-outlined text-red-600 text-2xl">{{ "picture_as_pdf" if a.tipo == "application/pdf" else "description" }}</span>
            <span class="flex-1 min-w-0 text-sm font-semibold text-gray-800 truncate">{{ a.nombre }}</span>
            <span aria-hidden="true" class="material-symbols-outlined text-primary text-lg">open_in_new</span>
          </a>
          {% endif %}
        </li>
        {% endfor %}
      </ul>
      {% endif %}
    </div>
  </article>

  <a href="/noticias.html" class="mt-8 inline-flex items-center gap-2 text-primary font-semibold text-sm hover:underline">
    <span aria-hidden="true" class="material-symbols-outlined text-base">arrow_back</span>Volver a Noticias
  </a>
</div>
