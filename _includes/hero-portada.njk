<!-- HERO DE PORTADA -->
<section id="hero-section" class="hero-fondo relative overflow-hidden text-white" aria-label="Bienvenida al {{ site.name }}">
  <div class="hero-blob -right-24 -top-24 w-[480px] h-[480px]" aria-hidden="true"></div>
  <div class="hero-blob right-36 -bottom-40 w-80 h-80" aria-hidden="true"></div>
  <div class="container mx-auto px-4 py-14 md:py-20 relative z-10">
    <div class="flex justify-end">
      <div class="max-w-xl">
        <p class="text-primary-light text-xs font-bold uppercase tracking-[0.2em] mb-3">{{ site.servicio }} · {{ site.region }}</p>
        <p class="text-4xl md:text-5xl font-bold mb-5 leading-tight">Cuidando tu salud<br><span class="text-primary-light">con dedicación</span></p>
        <p class="text-white/75 text-base md:text-lg mb-8 leading-relaxed">Atención médica pública de excelencia para Frutillar, Llanquihue y las comunidades del Lago Llanquihue.</p>
        <div class="flex flex-wrap gap-3">
          <a href="/servicios.html#urgencia" class="flex items-center gap-2 bg-red-600 hover:bg-red-700 text-white font-bold px-6 py-3 rounded-custom transition-colors shadow-lg">
            <span aria-hidden="true" class="material-symbols-outlined text-xl">emergency</span>Urgencias 24/7
          </a>
          <a href="/horarios.html" class="flex items-center gap-2 text-white font-semibold px-6 py-3 rounded-custom transition-colors border border-white/30 hover:bg-white/15">
            <span aria-hidden="true" class="material-symbols-outlined text-xl">schedule</span>Horarios
          </a>
          <a href="/servicios.html" class="flex items-center gap-2 text-white font-semibold px-6 py-3 rounded-custom transition-colors border border-white/30 hover:bg-white/15">
            <span aria-hidden="true" class="material-symbols-outlined text-xl">medical_services</span>Servicios
          </a>
        </div>
      </div>
    </div>
    <dl class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-12 pt-10 border-t border-white/15">
      {#- Servicios y años se calculan solos; funcionarios y población se editan en Portal → Contenido del sitio → Portada -#}
      {% set fun = inicio.cifras | buscar("id", "funcionarios") %}
      {% set pob = inicio.cifras | buscar("id", "poblacion") %}
      {% for c in [[servicios.servicios.length,"Servicios"],[fun],[site.fundacion | aniosDesde,"Años de servicio"],[pob]] %}
      <div class="text-center flex flex-col-reverse">
        {% if c[0].id %}
        {% set r = "inicio:cifras#" + c[0].id %}
        {% campo r + ".etiqueta", c[0].etiqueta, "dt", "text-sm text-white/60 mt-1.5 font-medium" %}
        {% campo r + ".valor", c[0].valor, "dd", "font-black text-4xl text-primary-light leading-none tabular-nums" %}
        {% else %}
        <dt class="text-sm text-white/60 mt-1.5 font-medium">{{ c[1] }}</dt>
        <dd class="font-black text-4xl text-primary-light leading-none tabular-nums">{{ c[0] }}</dd>
        {% endif %}
      </div>
      {% endfor %}
    </dl>
  </div>
</section>
