<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
{%- set tituloPagina = (title + " - " + site.name) if title else site.name %}
<title>{{ tituloPagina }}</title>
<meta name="description" content="{{ description or site.description }}">
{% if noindex %}<meta name="robots" content="noindex, nofollow">{% endif %}
<meta property="og:type" content="website">
<meta property="og:locale" content="es_CL">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ tituloPagina }}">
<meta property="og:description" content="{{ description or site.description }}">
{% if imagen %}<meta property="og:image" content="{{ imagen }}">{% endif %}
<link rel="icon" href="/img/logo-hospital.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Public+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,400&family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,1,0&display=swap">
<link rel="stylesheet" href="/assets/css/site.css?v={{ build.version }}">
</head>

<body class="font-sans antialiased bg-zinc-100 text-gray-800{% if portada %} es-portada{% endif %}">
<a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[60] focus:bg-white focus:text-primary focus:px-4 focus:py-2 focus:rounded-custom focus:shadow-lg">Saltar al contenido principal</a>

<!-- BARRA DE IDENTIDAD GOBIERNO DE CHILE -->
<div class="bg-white border-b border-gray-200">
  <div class="container mx-auto px-4 flex items-center justify-between py-1.5">
    <div class="flex items-center gap-2.5">
      <div class="flex items-center gap-px" aria-hidden="true">
        <span class="block w-1 h-4 rounded-sm bg-gob-rojo"></span>
        <span class="block w-1 h-4 rounded-sm bg-primary"></span>
      </div>
      <a href="https://www.gob.cl" target="_blank" rel="noopener" class="text-[11px] font-semibold text-gray-500 hover:text-primary transition-colors tracking-wide">Gobierno de Chile</a>
    </div>
    <a href="https://www.gob.cl" target="_blank" rel="noopener" class="text-[11px] text-gray-400 hover:text-primary transition-colors hidden sm:block">gob.cl</a>
  </div>
</div>

<!-- BARRA SUPERIOR -->
<div class="bg-gob-gris text-white text-xs py-1.5 border-b border-white/10">
  <div class="container mx-auto px-4 flex justify-between items-center flex-wrap gap-2">
    <div class="flex items-center gap-1.5 text-white/65">
      <span aria-hidden="true" class="material-symbols-outlined text-xs">location_on</span>
      {{ site.direccion }} &nbsp;·&nbsp; {{ site.region }}
    </div>
    <div class="flex gap-5 text-white/65">
      {% if site.facebook %}<a href="{{ site.facebook }}" target="_blank" rel="noopener" class="hover:text-white transition-colors">Facebook</a>{% endif %}
      {% if site.instagram %}<a href="{{ site.instagram }}" target="_blank" rel="noopener" class="hover:text-white transition-colors">Instagram</a>{% endif %}
      <a href="{{ site.ssreloncavi }}" target="_blank" rel="noopener" class="hover:text-white transition-colors">Servicio de Salud Reloncaví</a>
    </div>
  </div>
</div>

{% if portada %}{% include "hero-portada.njk" %}{% endif %}

<!-- ENCABEZADO + MENÚ -->
{% if portada %}<div class="sticky top-0 z-50">{% endif %}
<header id="site-header" class="bg-hospital text-white w-full{% if not portada %} shadow-md{% endif %}">
  <div class="hdr-wrap container mx-auto px-4 py-5">
    <div class="flex flex-col md:flex-row items-center justify-between gap-5">
      <a href="/" class="flex items-center gap-5 group" aria-label="{{ site.name }} — Inicio">
        <div class="hdr-logo w-20 h-20 rounded-custom flex-shrink-0 overflow-hidden shadow-lg border-2 border-white/30">
          <img src="/img/logo-hospital.png" alt="" width="80" height="80" class="w-full h-full object-cover">
        </div>
        <div>
          <p class="hdr-shrink text-[10px] font-bold tracking-widest uppercase text-white/60 mb-1">Trabajando para usted</p>
          <h1 class="hdr-title text-3xl md:text-4xl font-bold tracking-tight leading-tight group-hover:text-primary-pale transition-colors">Hospital de <span class="text-primary-light">Frutillar</span></h1>
          <div class="hdr-shrink w-48 border-t-2 border-dashed border-white/30 my-1.5"></div>
          <p class="hdr-shrink text-[11px] tracking-widest uppercase text-white/65">{{ site.servicio }}</p>
        </div>
      </a>
      <div class="hdr-shrink flex flex-col items-center md:items-end gap-3">
        <span class="text-[10px] tracking-widest uppercase text-white/40">Gobierno de Chile</span>
        <a href="{{ site.telefonoHref }}" class="flex items-center gap-2 text-white/80 hover:text-white text-sm transition-colors group">
          <span aria-hidden="true" class="material-symbols-outlined text-lg text-primary-light group-hover:text-white transition-colors">call</span>
          <span>{{ site.telefonoLabel }} <strong class="text-white">{{ site.telefono }}</strong></span>
        </a>
        <a href="{{ site.portalFuncionarios }}" class="flex items-center gap-2 bg-white/15 hover:bg-white text-white hover:text-primary-dark font-bold text-sm px-5 py-2.5 rounded-custom transition-all shadow border border-white/30">
          <span aria-hidden="true" class="material-symbols-outlined text-base">lock</span>
          Portal Funcionarios
        </a>
      </div>
    </div>
  </div>
</header>

<nav class="bg-gob-gris shadow-lg{% if not portada %} sticky top-0 z-40{% endif %}" aria-label="Menú principal">
  <div class="container mx-auto px-4">
    <ul class="hidden md:flex flex-wrap items-center text-sm font-semibold text-white/80">
      {% for item in nav %}
      {% set activo = item | navActivo(page.url) %}
      <li class="border-r border-white/10{% if item.items %} relative group{% endif %}">
        <a href="{{ item.url }}" class="flex items-center py-4 px-5 {% if activo %}text-white font-bold border-b-2 border-primary-light bg-white/15{% else %}hover:bg-white/10 hover:text-white transition-colors{% endif %}"{% if activo %} aria-current="page"{% endif %}>
          {{ item.label }}{% if item.items %}<span aria-hidden="true" class="material-symbols-outlined text-sm ml-1">expand_more</span>{% endif %}
        </a>
        {% if item.items %}
        <div class="hidden group-hover:block group-focus-within:block absolute top-full left-0 bg-white border border-gray-200 shadow-lg z-50 min-w-[220px] text-gray-700 divide-y divide-gray-100">
          {% for s in item.items %}<a href="{{ s.url }}" class="block px-5 py-3 text-sm hover:bg-primary-bg hover:text-primary">{{ s.label }}</a>{% endfor %}
        </div>
        {% endif %}
      </li>
      {% endfor %}
    </ul>
    <!-- Barra móvil -->
    <div class="flex md:hidden items-center justify-between py-3">
      <span class="text-sm font-bold text-white">{{ site.name }}</span>
      <button id="menu-toggle" type="button" class="flex items-center gap-1 text-white" aria-controls="mobile-menu" aria-expanded="false">
        <span id="menu-icon" aria-hidden="true" class="material-symbols-outlined text-2xl">menu</span>
        <span class="text-sm font-semibold">Menú</span>
      </button>
    </div>
  </div>
  <!-- Menú móvil -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-white/10 bg-[#1e1e22] shadow-lg max-h-[80vh] overflow-y-auto">
    <ul class="divide-y divide-white/10 text-sm font-semibold text-white/85">
      {% for item in nav %}
      <li>
        {% if item.items %}
        <button type="button" class="mobile-submenu-btn w-full flex items-center justify-between px-4 py-3.5 hover:bg-white/10 transition-colors" aria-controls="msub-{{ item.id }}" aria-expanded="false">
          <span>{{ item.label }}</span>
          <span aria-hidden="true" class="material-symbols-outlined text-lg expand-icon text-white/40">expand_more</span>
        </button>
        <div id="msub-{{ item.id }}" class="hidden bg-white/5 border-t border-white/10 divide-y divide-white/10">
          {% for s in item.items %}<a href="{{ s.url }}" class="block pl-8 pr-4 py-2.5 text-sm hover:text-primary-light font-normal">{{ s.label }}</a>{% endfor %}
        </div>
        {% else %}
        <a href="{{ item.url }}" class="flex items-center px-4 py-3.5 hover:bg-white/10 transition-colors{% if item | navActivo(page.url) %} text-primary-light{% endif %}">{{ item.label }}</a>
        {% endif %}
      </li>
      {% endfor %}
      <li>
        <a href="{{ site.portalFuncionarios }}" class="flex items-center gap-2 px-4 py-3.5 text-primary-light hover:bg-white/10 font-bold">
          <span aria-hidden="true" class="material-symbols-outlined text-base">lock</span> Portal Funcionarios
        </a>
      </li>
    </ul>
  </div>
</nav>
{% if portada %}</div>{% endif %}

<!-- CONTENIDO -->
<main id="main-content" tabindex="-1">
  {{ content | safe }}
</main>

<!-- LINKS DE INTERÉS -->
<section class="bg-white border-t border-gray-200 py-12 mt-4" aria-labelledby="titulo-links">
  <div class="container mx-auto px-4">
    <div class="flex items-center gap-4 mb-7">
      <div class="h-px bg-gray-200 flex-1"></div>
      <h2 id="titulo-links" class="font-bold text-gray-500 text-xs uppercase tracking-[0.2em] whitespace-nowrap">Links de Interés</h2>
      <div class="h-px bg-gray-200 flex-1"></div>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 max-w-4xl mx-auto">
      {% for l in links %}
      <a href="{{ l.url }}" target="_blank" rel="noopener" class="gob-stripe group bg-gray-50 border border-gray-200 rounded-custom p-4 flex flex-col items-center text-center gap-2 min-h-[80px] shadow-sm hover:shadow-md hover:bg-primary-bg hover:border-primary-pale transition-all">
        <span aria-hidden="true" class="material-symbols-outlined text-gray-400 group-hover:text-primary transition-colors text-2xl">{{ l.icon }}</span>
        <span class="text-[11px] font-bold text-gray-600 group-hover:text-primary transition-colors leading-tight">{{ l.label }}</span>
      </a>
      {% endfor %}
    </div>
  </div>
</section>

<!-- BANNER CONTACTO -->
<section class="bg-hospital-deep text-white py-10" aria-label="Información de contacto">
  <div class="container mx-auto px-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
    <div class="flex flex-col gap-2">
      <div class="flex items-center gap-2 mb-1">
        <span aria-hidden="true" class="material-symbols-outlined text-primary-light text-xl">location_on</span>
        <h3 class="font-bold text-sm uppercase tracking-widest text-white/70">Dirección</h3>
      </div>
      <p class="text-white font-semibold leading-snug">{{ site.direccion }}<br>{{ site.region }}, Chile</p>
      <a href="{{ site.mapsUrl }}" target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 text-primary-light hover:text-white text-sm font-semibold transition-colors mt-1">
        <span aria-hidden="true" class="material-symbols-outlined text-base">open_in_new</span>Ver en Google Maps
      </a>
    </div>
    <div class="flex flex-col gap-2">
      <div class="flex items-center gap-2 mb-1">
        <span aria-hidden="true" class="material-symbols-outlined text-primary-light text-xl">call</span>
        <h3 class="font-bold text-sm uppercase tracking-widest text-white/70">Teléfonos</h3>
      </div>
      <div>
        <p class="text-[10px] text-white/55 uppercase tracking-widest">{{ site.telefonoLabel }}</p>
        <a href="{{ site.telefonoHref }}" class="text-white font-black text-2xl leading-tight hover:text-primary-light transition-colors">{{ site.telefono }}</a>
      </div>
      <div class="mt-1">
        <p class="text-[10px] text-white/55 uppercase tracking-widest">Central Hospital</p>
        <a href="{{ site.telefonoCentralHref }}" class="text-white font-semibold hover:text-primary-light transition-colors">{{ site.telefonoCentral }}</a>
      </div>
    </div>
    <div class="flex flex-col gap-2">
      <div class="flex items-center gap-2 mb-1">
        <span aria-hidden="true" class="material-symbols-outlined text-primary-light text-xl">schedule</span>
        <h3 class="font-bold text-sm uppercase tracking-widest text-white/70">Horarios</h3>
      </div>
      <ul class="flex flex-col gap-1.5 text-sm">
        <li class="flex items-center gap-2"><span aria-hidden="true" class="w-2 h-2 bg-red-400 rounded-full flex-shrink-0"></span><span><strong>Urgencias</strong> <span class="text-white/70">— 24/7</span></span></li>
        <li class="flex items-center gap-2"><span aria-hidden="true" class="w-2 h-2 bg-green-400 rounded-full flex-shrink-0"></span><span><strong>Consultas</strong> <span class="text-white/70">— Lun–Vie 8:00–17:00</span></span></li>
        <li class="flex items-center gap-2"><span aria-hidden="true" class="w-2 h-2 bg-primary-light rounded-full flex-shrink-0"></span><span><strong>Laboratorio</strong> <span class="text-white/70">— Lun–Sáb 7:30–12:00</span></span></li>
      </ul>
      <a href="/horarios.html" class="text-primary-light hover:text-white text-xs font-semibold transition-colors mt-1">Ver todos los horarios →</a>
    </div>
    <div class="flex flex-col gap-2">
      <div class="flex items-center gap-2 mb-1">
        <span aria-hidden="true" class="material-symbols-outlined text-primary-light text-xl">mail</span>
        <h3 class="font-bold text-sm uppercase tracking-widest text-white/70">Contacto</h3>
      </div>
      <p class="text-sm text-white/75 leading-snug">¿Tienes dudas, sugerencias o reclamos? Escríbenos o visita nuestra Oficina de Información.</p>
      <a href="/contacto.html" class="mt-2 inline-flex items-center justify-center gap-2 bg-white text-primary-dark font-bold text-sm px-5 py-2.5 rounded-custom hover:bg-primary-pale transition-colors shadow">
        <span aria-hidden="true" class="material-symbols-outlined text-base">send</span>Ir a Contacto
      </a>
    </div>
  </div>
</section>

<!-- PIE DE PÁGINA -->
<footer class="bg-footer text-gray-300 py-10">
  <div class="container mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
      <div class="md:col-span-2">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-10 h-10 rounded-custom flex-shrink-0 overflow-hidden border border-white/20">
            <img src="/img/logo-hospital.png" alt="" width="40" height="40" class="w-full h-full object-cover">
          </div>
          <p class="text-white font-bold text-base leading-tight">{{ site.name }}<br><span class="text-primary-light font-normal text-sm">{{ site.servicio }}</span></p>
        </div>
        <p class="text-sm leading-relaxed mb-4 text-gray-400">Cuidado de excelencia en el corazón de la cuenca del Lago Llanquihue. Comprometidos con la salud y bienestar de nuestra comunidad.</p>
      </div>
      <div>
        <h2 class="text-white font-bold text-sm mb-4 uppercase tracking-wide">Información</h2>
        <ul class="space-y-2 text-sm">
          <li><a href="/carta-derechos.html" class="hover:text-white transition-colors">Carta de Derechos y Deberes</a></li>
          <li><a href="/transparencia.html#activa" class="hover:text-white transition-colors">Transparencia Activa</a></li>
          <li><a href="/transparencia.html#ley-lobby" class="hover:text-white transition-colors">Ley del Lobby</a></li>
          <li><a href="/transparencia.html#solicitud" class="hover:text-white transition-colors">Solicitud de Información</a></li>
        </ul>
      </div>
      <div>
        <h2 class="text-white font-bold text-sm mb-4 uppercase tracking-wide">Institucional</h2>
        <ul class="space-y-2 text-sm">
          <li><a href="/quienes-somos.html" class="hover:text-white transition-colors">Quiénes Somos</a></li>
          <li><a href="/trabaja-con-nosotros.html" class="hover:text-white transition-colors">Trabaja con Nosotros</a></li>
          <li><a href="/contacto.html" class="hover:text-white transition-colors">Contacto y Cómo Llegar</a></li>
          <li><a href="{{ site.portalFuncionarios }}" class="hover:text-white transition-colors">Portal Funcionarios</a></li>
        </ul>
      </div>
    </div>
    <div class="border-t border-white/10 pt-6 text-xs text-gray-500 text-center md:text-left">
      © {{ build.year }} {{ site.name }} &nbsp;·&nbsp; {{ site.servicio }} &nbsp;·&nbsp; Gobierno de Chile
    </div>
  </div>
</footer>

<script src="/assets/js/site.js?v={{ build.version }}" defer></script>
{% for s in scripts or [] %}<script src="{{ s }}?v={{ build.version }}"{% if s.endsWith(".mjs") %} type="module"{% else %} defer{% endif %}></script>{% endfor %}
</body>
</html>
